/* Resource strings are stored as Unicode. */
#pragma code_page(65001)
#include <windows.h>
#include "update_config.h"
1 24 "app.manifest"
1 ICON "app.ico"
1 VERSIONINFO
 FILEVERSION APP_VERSION_NUMERIC
 PRODUCTVERSION APP_VERSION_NUMERIC
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "LOL Skin Information Searching"
   VALUE "FileVersion", APP_VERSION_RESOURCE
   VALUE "ProductName", "LOL-Skin-Information-Searching"
   VALUE "ProductVersion", APP_VERSION_RESOURCE
   VALUE "OriginalFilename", "LOL-Skin-Information-Searching_v1.0.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END


300 DIALOGEX 0, 0, 350, 148
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GitHub 更新设置 · v1.0"
FONT 10, "Microsoft YaHei UI"
BEGIN
 LTEXT "GitHub 仓库", 302, 16, 14, 310, 14
 EDITTEXT 301, 16, 34, 318, 22, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "填写 owner/repository 或仓库链接。留空则暂停检测。", 303, 16, 64, 318, 16
 LTEXT "每次启动自动检查正式版本；有更新时提醒前往下载。", 304, 16, 84, 318, 16
 DEFPUSHBUTTON "保存并检查", IDOK, 169, 116, 91, 22
 PUSHBUTTON "取消", IDCANCEL, 269, 116, 65, 22
END
